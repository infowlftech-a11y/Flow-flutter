rules_version = '2';

// Flow — Firestore security rules.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// A new project starts either locked (deny all) or in test mode (allow all,
// expiring in 30 days). Neither is what this app needs, so these rules are
// written against the collections in lib/data/firestore_paths.dart. Renaming
// a collection there means updating this file in the same change.
//
// Principle: a user owns their own documents; staff moderate; the fields that
// decide who someone *is* (role, status, blockedUntil) can only ever be
// written by staff — otherwise any rider could self-approve as a trainer or
// lift their own suspension.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function selfProfile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isStaff() {
      return signedIn()
        && selfProfile().role in ['admin', 'owner', 'support'];
    }

    // A suspension has to bite at the API, not only in the app's routing.
    //
    // Nothing here read `status` before, so a blocked account kept a valid
    // token and full write access: it could still book, message the rider who
    // reported it, and post reviews. The gate in the client stopped the app
    // from *offering* those things, which is not the same as preventing them —
    // the same distinction that made a rider able to confirm their own
    // booking.
    //
    // Deliberately applied to `create` only, and only where a suspended
    // account can reach someone else. What stays open:
    //   * appeals      — the whole point of a suspension is to be appealable
    //   * tickets      — support is the other lifeline
    //   * leave_reasons — they may still delete their account (§3.13)
    //   * every read   — they must see their own gate and appeal
    //   * booking *updates* — otherwise a blocked rider cannot cancel, and
    //     holds a trainer's calendar until the suspension lifts
    //
    // Fails closed: a signed-in user with no profile document is denied
    // rather than let through.
    function notBlocked() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && selfProfile().status != 'blocked';
    }

    // Fields a user must never be able to set on themselves.
    //
    // `statusBeforeBlock` is on the list because unblockUser *restores* it:
    // a pending trainer who could pre-write `statusBeforeBlock: 'active'`
    // would come out of any later suspension approved without review.
    function privilegedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'status', 'blockedUntil', 'blockedAt', 'reviewedAt',
                 'reviewNote', 'statusBeforeBlock']);
    }

    // ── users ────────────────────────────────────────────────────────────
    // Any signed-in user can read profiles: Explore lists trainers, chat and
    // bookings show partner names and photos.
    match /users/{userId} {
      allow read: if signedIn();

      // Onboarding writes the profile once. `status` is pinned server-side:
      // riders may self-activate, business accounts must start pending and
      // wait for the admin console.
      allow create: if signedIn() && userId == uid()
        && (
          (request.resource.data.role == 'kiter'
            && request.resource.data.status == 'active')
          || (request.resource.data.role == 'business'
            && request.resource.data.status == 'pending')
        );

      // A declined trainer may put a corrected application back in the queue.
      //
      // The only status transition a user may write for themselves, and it
      // is safe because of where it lands: `pending` is not bookable, so
      // re-applying buys nothing except another review by a human. Pinned to
      // `rejected` as the starting point — a blocked account must not launder
      // itself into pending, and a pending one must not promote itself — and
      // the fields that decide who someone is stay untouchable either way.
      // `reviewNote`/`reviewedAt` are cleared with it: they describe the
      // decision on the submission being replaced.
      function isReapplication() {
        return resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
          && request.resource.data.role == resource.data.role
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['role', 'blockedUntil', 'blockedAt',
                        'statusBeforeBlock']);
      }

      allow update: if signedIn()
        && ((userId == uid()
              && (privilegedFieldsUnchanged() || isReapplication()))
            || isStaff());

      // Account deletion (§3.13) — own profile only.
      allow delete: if signedIn() && userId == uid();

      // Station catalogue: public to read, owner-managed.
      match /station_instructors/{docId} {
        allow read: if signedIn();
        allow write: if signedIn() && (userId == uid() || isStaff());
      }
      match /station_services/{docId} {
        allow read: if signedIn();
        allow write: if signedIn() && (userId == uid() || isStaff());
      }
    }

    // ── bookings ─────────────────────────────────────────────────────────
    // Readable by the two parties. Queries filter on kiterId or instructorId,
    // so a list request is authorised by its filter.
    match /bookings/{bookingId} {
      function isParty() {
        return resource.data.kiterId == uid()
            || resource.data.instructorId == uid();
      }

      // The trainer is the one who is owed, so they are the only party who
      // can say they were paid.
      function isProvider() {
        return resource.data.instructorId == uid();
      }

      // Money fields. A rider must never be able to write these: one who
      // could set their own booking to `paid` could walk off the beach owing
      // for the lesson with the app agreeing that they did not.
      function paymentFieldsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['paymentStatus', 'paymentMethod', 'paidAt', 'refundedAt',
                   'paymentRef', 'amountDue', 'currency', 'totalPrice']);
      }

      // What a rider may touch after the booking exists, as a closed set.
      //
      // Stripping money fields from an otherwise open document was not
      // enough: `status`, `date` and `instructorId` were left writable, so a
      // rider could confirm their own pending request, check themselves in
      // without the QR scan, self-complete a session to unlock a review for
      // a lesson that never ran (§8.9), or move the booking onto another
      // trainer's calendar. A rider's real write surface is exactly one call
      // — `cancelByRider` — plus `hide`.
      function riderFieldsOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelledAt', 'cancelledBy', 'hiddenByGuest',
                    'updatedAt']);
      }

      // …and `cancelled` is the only status a rider may write — stamped.
      // `cancelledBy`/`cancelledAt` are what the cancellation policy reads
      // to decide whether the held payment refunds (before the free-cancel
      // deadline) or is charged (P1), so a rider cancel may not exist
      // without them. Presence is what is provable here; the timestamp's
      // honesty is the processor's to verify when it executes the refund.
      function riderStatusIsCancellation() {
        return !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['status'])
            || (request.resource.data.status == 'cancelled'
                && request.resource.data.cancelledBy == 'user'
                && 'cancelledAt' in request.resource.data);
      }

      // The trainer's writable set, closed the same way the rider's is.
      // Everything the repository writes for a provider: approve/decline/
      // complete (status, updatedAt), check-in (checkedIn, startedAt),
      // settlement (the payment fields), and history hiding. What is *not*
      // here is the point: `instructorId` — so a booking cannot be handed to
      // a trainer who never accepted it (BUG-003) — and `date`, `kiterId`,
      // `selectedTimes`, so the session a rider agreed to cannot be quietly
      // moved under them.
      function providerFieldsOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'checkedIn', 'startedAt',
                    'paymentStatus', 'paymentMethod', 'paidAt', 'refundedAt',
                    'paymentRef', 'hiddenByInstructor',
                    // A provider cancellation stamps itself like a rider's —
                    // 'provider' in cancelledBy is what makes it refund in
                    // full under the escrow derivation (P1).
                    'cancelledAt', 'cancelledBy']);
      }

      // A booking is its two parties' business, and staff's. The grid and
      // the clash check — which do need a stranger to see a trainer's booked
      // hours — read the `occupied` availability docs instead (§8.5), which
      // carry the hours and none of the rider's name, message or price.
      // (This line was briefly `signedIn()` while nothing wrote those docs —
      // BUG-017 — which made the whole collection listable.)
      allow read: if signedIn() && (isParty() || isStaff());

      // A rider-created booking is born 'pending' — unless the trainer
      // opted into Instant Book on their own profile, in which case it may
      // be born 'confirmed' (P5). The get() re-checks the trainer's flag at
      // rule time, so the client's copy of it proves nothing. Before P5 the
      // create rule did not constrain status at all, which let a hand-rolled
      // client self-confirm against any trainer; this closes that too.
      function trainerAllowsInstant() {
        return get(/databases/$(database)/documents/users/
          $(request.resource.data.instructorId)).data.instantBook == true;
      }

      // On create the rider states what they owe ('unpaid', the cash era) or
      // what they have put in escrow ('held' — paid to FLOW at booking, P1),
      // never that the trainer was settled: 'paid' stays rider-refused. A
      // trainer creating a walk-in may record cash taken up front, so the
      // constraints are on riders only.
      allow create: if signedIn() && notBlocked()
        && (request.resource.data.kiterId == uid()
            || request.resource.data.instructorId == uid())
        && (request.resource.data.instructorId == uid()
            || (request.resource.data.paymentStatus in ['unpaid', 'held']
                && (request.resource.data.status == 'pending'
                    || (request.resource.data.status == 'confirmed'
                        && trainerAllowsInstant()))));

      // Order matters here, for cost as much as clarity. `isStaff()` does a
      // `get()` on the caller's profile — a billed read, and one of only ten
      // a single request is allowed. The two parties account for essentially
      // every booking update, and both are answerable from the document
      // already loaded, so they are checked first and staff is the fallback.
      // Evaluating isStaff() first also threw outright for any signed-in user
      // with no profile document rather than simply denying them.
      allow update: if signedIn()
        && ((isProvider() && providerFieldsOnly())
            || (isParty() && paymentFieldsUnchanged()
                && riderFieldsOnly() && riderStatusIsCancellation())
            || isStaff());

      allow delete: if isStaff();
    }

    // ── availability & vacations (trainer-owned calendar) ────────────────
    // Readable by everyone signed in: the booking grid needs a trainer's
    // blocks to compute what is actually free.
    //
    // Two kinds of document share this collection (§8.5). `host-blocked` is
    // the trainer's own calendar and only they write it. `occupied` is a
    // booking's shadow: it carries a live booking's hours — and nothing else,
    // no name, no message, no price — so that a rider who cannot read the
    // booking itself can still see the hour is gone. It is keyed by the
    // booking's id and written in the same atomic commit, which is what lets
    // these rules authorise the rider's write: `getAfter` reads the sibling
    // booking as the commit will leave it.
    match /availability/{docId} {
      function bookingAfter() {
        return getAfter(
          /databases/$(database)/documents/bookings/$(docId)).data;
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && (request.resource.data.instructorId == uid()
            || isStaff()
            || (request.resource.data.status == 'occupied'
                && bookingAfter().kiterId == uid()
                && bookingAfter().instructorId
                    == request.resource.data.instructorId));
      // The rider may delete exactly one thing: the occupied doc of their
      // own booking, in the same commit that cancels it.
      allow update, delete: if signedIn()
        && (resource.data.instructorId == uid()
            || isStaff()
            || (resource.data.status == 'occupied'
                && bookingAfter().kiterId == uid()
                && bookingAfter().status == 'cancelled'));
    }

    match /vacations/{docId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.instructorId == uid();
      allow update, delete: if signedIn()
        && (resource.data.instructorId == uid() || isStaff());
    }

    // ── reviews ──────────────────────────────────────────────────────────
    // Public to read (ratings drive Explore). Authors may delete their own.
    //
    // Eligibility is enforced *here*, not only in the repository: a rating
    // that drives Explore is only worth what its worst entry, and a direct
    // Firestore client used to be able to review a trainer it never trained
    // with, or a booking that never existed (BUG-004). The rule reads the
    // named booking — one billed get per review write — and requires the
    // §8.9 facts: it completed, this author was the rider on it, and it was
    // with this trainer. What it still cannot enforce is one-review-per-
    // booking: that needs a deterministic review id, which is a document-
    // shape change. The repository's re-check keeps holding that line.
    match /reviews/{reviewId} {
      function reviewedBooking() {
        return get(/databases/$(database)/documents/bookings/
          $(request.resource.data.bookingId)).data;
      }

      allow read: if signedIn();
      allow create: if signedIn() && notBlocked()
        && request.resource.data.userId == uid()
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.bookingId is string
        && reviewedBooking().status == 'completed'
        && reviewedBooking().kiterId == uid()
        && reviewedBooking().instructorId == request.resource.data.trainerId;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.userId == uid() || isStaff());
    }

    // ── chats ────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      function isParticipant() {
        return uid() in resource.data.participants;
      }

      // Who is in a conversation is fixed when it opens. Leaving this field
      // writable let a participant add an outsider — which grants them every
      // message in the thread, since the sub-collection resolves access
      // through this same array — or drop the other party, who then loses a
      // thread that `allow delete: if false` means nobody can ever remove.
      //
      // `ensureThread` re-writes `participants` on every open, but always the
      // identical sorted pair, so this leaves it untouched.
      function participantsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['participants']);
      }

      allow read: if signedIn() && isParticipant();
      // The thread is created on first open, so authorise from the payload.
      allow create: if signedIn() && notBlocked()
        && uid() in request.resource.data.participants;
      allow update: if signedIn() && isParticipant() && participantsUnchanged();
      allow delete: if false;

      match /messages/{messageId} {
        function inThread() {
          return uid() in
            get(/databases/$(database)/documents/chats/$(chatId))
              .data.participants;
        }

        allow read: if signedIn() && inThread();
        allow create: if signedIn() && inThread() && notBlocked()
          && request.resource.data.senderId == uid();
        // Messages are immutable once sent.
        allow update, delete: if false;
      }
    }

    // ── notifications ────────────────────────────────────────────────────
    // Recipients read and mark their own read/deleted. The app notifies the
    // *other* party (a rider's booking notifies the trainer), so a create is
    // permitted only across a real relationship: the two parties of the
    // booking it names, or two people who already share a chat thread.
    // `allow create: if signedIn()` used to be the whole rule, which let any
    // account render a convincing "Booking approved ✅" in any stranger's
    // inbox (BUG-005). The Cloud Function that sends FCM runs with admin
    // credentials and bypasses these rules.
    //
    // Deliberately NOT notBlocked(): a blocked rider may still cancel, and
    // that cancel must still warn the trainer. The relationship constraint is
    // what keeps a blocked account from reaching anyone new.
    match /notifications/{notificationId} {
      function target() {
        return request.resource.data.targetUserId;
      }

      // The booking the notification claims to be about — both the sender
      // and the recipient must be its parties, in either role.
      function aboutSharedBooking() {
        let b = get(/databases/$(database)/documents/bookings/
          $(request.resource.data.bookingId)).data;
        return (b.kiterId == uid() || b.instructorId == uid())
            && (b.kiterId == target() || b.instructorId == target());
      }

      // Chat threads are keyed `idFor(a, b)` — the sorted pair — so the
      // thread between sender and target has exactly one possible id.
      function sharesThreadWithTarget() {
        return exists(/databases/$(database)/documents/chats/
          $(uid() < target() ? uid() + '_' + target()
                             : target() + '_' + uid()));
      }

      allow read, update, delete: if signedIn()
        && (resource.data.targetUserId == uid() || isStaff());
      allow create: if signedIn()
        && (isStaff()
            || (target() != uid()
                && (('bookingId' in request.resource.data
                     && aboutSharedBooking())
                    || (request.resource.data.type == 'message'
                        && sharesThreadWithTarget()))));
    }

    // ── support tickets ──────────────────────────────────────────────────
    match /tickets/{ticketId} {
      allow read: if signedIn()
        && (resource.data.userId == uid() || isStaff());
      allow create: if signedIn()
        && request.resource.data.userId == uid();
      allow update: if signedIn()
        && (resource.data.userId == uid() || isStaff());
      allow delete: if isStaff();

      match /messages/{messageId} {
        function ownsTicket() {
          return get(/databases/$(database)/documents/tickets/$(ticketId))
            .data.userId == uid();
        }

        allow read: if signedIn() && (ownsTicket() || isStaff());
        allow create: if signedIn() && (ownsTicket() || isStaff());
        allow update, delete: if false;
      }
    }

    // ── appeals ──────────────────────────────────────────────────────────
    // Written by suspended users, so the rules cannot require an active
    // account — only that they are authenticated and appealing for themselves.
    match /appeals/{appealId} {
      allow read: if signedIn()
        && (resource.data.userId == uid() || isStaff());
      allow create: if signedIn()
        && request.resource.data.userId == uid();
      // Both sides append to the `messages` array; staff also set `status`.
      allow update: if signedIn()
        && (resource.data.userId == uid() || isStaff());
      allow delete: if isStaff();
    }

    // ── reports ──────────────────────────────────────────────────────────
    // Write-only for riders: you may file one, but you may not read what
    // others filed, or discover that you have been reported.
    match /reports/{reportId} {
      allow read: if isStaff();
      allow create: if signedIn() && notBlocked()
        && request.resource.data.reporterId == uid();
      allow update, delete: if isStaff();
    }

    // ── leave reasons (account-deletion feedback) ────────────────────────
    match /leave_reasons/{docId} {
      allow read: if isStaff();
      allow create: if signedIn()
        && request.resource.data.userId == uid();
      allow update, delete: if false;
    }

    // ── safari trips ─────────────────────────────────────────────────────
    // Public to read; the host manages them. The seat count lives on this
    // document and is moved by the *reserving rider's* transaction, so a
    // non-host update cannot simply be denied — but `allow update: if
    // signedIn()` authorised every field, so any account could zero a
    // competitor's price or set capacity 999 (BUG-006). A non-host may now
    // move exactly what the reservation and its cancel move: `bookedSeats`
    // by one seat at a time, inside [0, capacity], and `status` between
    // open/full. One seat per write is the shape of every legitimate call;
    // it does still let a signed-in stranger walk a manifest up seat by
    // seat, which only a server-held ledger could fully prevent.
    match /safari_trips/{tripId} {
      function seatFieldsOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['bookedSeats', 'status']);
      }

      function seatMoveOk() {
        return !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['bookedSeats'])
            || (request.resource.data.bookedSeats is int
                && (request.resource.data.bookedSeats
                      - resource.data.get('bookedSeats', 0)) in [1, -1]
                && request.resource.data.bookedSeats >= 0
                && (resource.data.get('capacity', 0) <= 0
                    || request.resource.data.bookedSeats
                        <= resource.data.capacity));
      }

      function seatStatusOk() {
        return !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['status'])
            || request.resource.data.status in ['open', 'full'];
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostId == uid();
      allow update: if signedIn()
        && (resource.data.hostId == uid()
            || isStaff()
            || (seatFieldsOnly() && seatMoveOk() && seatStatusOk()));
      allow delete: if signedIn()
        && (resource.data.hostId == uid() || isStaff());
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
